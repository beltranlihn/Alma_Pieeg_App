{
  "name": "eeg-alma-center",
  "productName": "EEG Alma Center",
  "version": "0.13.2",
  "description": "EEG Alma Center — receive, clean, calibrate, visualize and route biosignals (PiEEG XR first) · Alma Digital Studio",
  "author": "Alma Digital Studio",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.2"
  },
  "build": {
    "appId": "com.almadigitalstudio.eegalmacenter",
    "productName": "EEG Alma Center",
    "copyright": "Copyright © 2026 Alma Digital Studio",
    "publish": null,
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "osc-encode.js",
      "ant.js",
      "ws-server.js",
      "index.html",
      "src/**/*",
      "assets/**/*",
      "package.json",
      "LICENSE",
      "THIRD-PARTY-NOTICES.md"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "EEG-Alma-Center-${version}-${arch}.${ext}",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "artifactName": "EEG-Alma-Center-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "EEG-Alma-Center-${version}-portable.${ext}"
    },
    "asarUnpack": [
      "node_modules/usb/**"
    ]
  },
  "dependencies": {
    "ant-plus-next": "^0.4.0"
  }
}
